# Alpha Guard has no mandatory secret for validation, health checks, or dry-run.
# Copy this file to .env. Keep real secrets out of source control.

# REQUIRED only for real Telegram delivery. Delivery stays off unless this
# switch is explicitly changed to true and both credentials below are set.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONAL Meta WhatsApp Cloud API delivery. This has its own explicit opt-in;
# NOTIFICATIONS_ENABLED does not enable it. Use an opted-in E.164 recipient.
# Signal, incident, and trust template names are required when enabled; news is
# optional. Names must be lowercase ASCII letters/digits/underscores and refer
# to templates already approved in WhatsApp Manager.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TIMEOUT_SECONDS=10
WHATSAPP_TEMPLATE_LANGUAGE_CODE=zh_CN
WHATSAPP_SIGNAL_TEMPLATE_NAME=
WHATSAPP_INCIDENT_TEMPLATE_NAME=
WHATSAPP_NEWS_TEMPLATE_NAME=
WHATSAPP_TRUST_TEMPLATE_NAME=

# OPTIONAL external dead-man watcher. The URL path is normally a secret and
# is never shown by status/doctor. Public endpoints should use HTTPS.
HEARTBEAT_ENABLED=false
HEARTBEAT_URL=
HEARTBEAT_TIMEOUT_SECONDS=5

# OPTIONAL: required only when the matching source is enabled in news/config.yaml.
FINNHUB_API_KEY=
NEWSAPI_API_KEY=

# OPTIONAL: required only when ai_filter.enabled is true. Without a key, news
# processing deterministically falls back to keyword-only human review.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OPTIONAL request timeout for HTTP news providers (seconds, >0 and <=120).
HTTP_TIMEOUT_SECONDS=10

# OPTIONAL Futu OpenAPI read-only quotes. Requires the
# `futu` extra (`uv sync --frozen --extra futu`) and a running OpenD gateway.
# OpenD must stay on this Mac's loopback interface; Alpha Guard never requests
# trading permission or sends orders.
FUTU_ENABLED=false
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_QUOTE_PORT=11111
